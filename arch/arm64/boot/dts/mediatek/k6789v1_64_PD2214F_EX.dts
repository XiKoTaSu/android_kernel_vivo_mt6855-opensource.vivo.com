		"lcm_vddr_out1_gpio", "lcm_vddr_out0_gpio",
		"lcm_elvdd_out1_gpio", "lcm_elvdd_out0_gpio",
		"lcm_errflag_out1_gpio", "lcm_errflag_out0_gpio";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;

/dts-v1/;
/plugin/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6789-pinfunc.h>
#include <dt-bindings/gpio/gpio.h>
//#include "mediatek/cust_mt6789_camera.dtsi"

&chosen {
	bootargs = "console=tty0 root=/dev/ram \
			    loglevel=8 log_buf_len=2m \
			    androidboot.hardware=mt6789 \
			    initcall_debug=1";
		atag,videolfb-fb_base_l = <0x7e605000>;
		atag,videolfb-fb_base_h = <0x0>;
		atag,videolfb-islcmfound = <1>;
		atag,videolfb-islcm_inited = <0>;
		atag,videolfb-fps= <6000>;
		atag,videolfb-vramSize= <0x1be0000>;
		atag,videolfb-lcmname=
			"nt36672e_fhdp_dsi_vdo_60hz_jdi_dphy_drv";
		atag,vivo-dsi-panel-type = "oled";
		default-backlight-level = <573>;
};

&mtk_leds {
    compatible = "mediatek,disp-leds";

    backlight {
        label = "lcd-backlight";
        max-brightness = <2047>;
        led-bits = <11>;
        default-state = "on";
        led_mode = <4>;
    };
};

/* Trustonic Mobicore real driver */
&mobicore {
	trustonic,real-drv = <1>;
};

&pio {
	mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO85__FUNC_GPIO85>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO85__FUNC_GPIO85>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO83__FUNC_DSI_TE>;
		};
	};
	mtkfb_pins_lcm_vci_out1_gpio: lcm_vci_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-high;
		};
	};
	mtkfb_pins_lcm_vci_out0_gpio: lcm_vci_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_vddi_out1_gpio: lcm_vddi_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO54__FUNC_GPIO54>;
			slew-rate = <1>;
			output-high;
		};
	};
	mtkfb_pins_lcm_vddi_out0_gpio: lcm_vddi_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO54__FUNC_GPIO54>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_vddr_out1_gpio: lcm_vddr_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			slew-rate = <1>;
			output-high;
		};
	};
	mtkfb_pins_lcm_vddr_out0_gpio: lcm_vddr_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_elvdd_out1_gpio: lcm_elvdd_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO61__FUNC_GPIO61>;
			slew-rate = <1>;
			output-high;
		};
	};
	mtkfb_pins_lcm_elvdd_out0_gpio: lcm_elvdd_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO61__FUNC_GPIO61>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_errflag_out1_gpio: lcm_errflag_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
			slew-rate = <1>;
			output-high;
		};
	};
	mtkfb_pins_lcm_errflag_out0_gpio: lcm_errflag_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&mtkfb {
	pinctrl-names = "lcm_led_en1_gpio", "lcm_led_en0_gpio",
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te",
		"lcm_vci_out1_gpio", "lcm_vci_out0_gpio",
		"lcm_vddi_out1_gpio", "lcm_vddi_out0_gpio",
		"lcm_vddr_out1_gpio", "lcm_vddr_out0_gpio",
		"lcm_elvdd_out1_gpio", "lcm_elvdd_out0_gpio",
		"lcm_errflag_out1_gpio", "lcm_errflag_out0_gpio";
	pinctrl-0 = <&mtkfb_pins_lcm_led_en1>;
	pinctrl-1 = <&mtkfb_pins_lcm_led_en0>;
	pinctrl-2 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-3 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
	pinctrl-5 = <&mtkfb_pins_lcm_vci_out1_gpio>;
	pinctrl-6 = <&mtkfb_pins_lcm_vci_out0_gpio>;
	pinctrl-7 = <&mtkfb_pins_lcm_vddi_out1_gpio>;
	pinctrl-8 = <&mtkfb_pins_lcm_vddi_out0_gpio>;
	pinctrl-9 = <&mtkfb_pins_lcm_vddr_out1_gpio>;
	pinctrl-10 = <&mtkfb_pins_lcm_vddr_out0_gpio>;
	pinctrl-11 = <&mtkfb_pins_lcm_elvdd_out1_gpio>;
	pinctrl-12 = <&mtkfb_pins_lcm_elvdd_out0_gpio>;
	pinctrl-13 = <&mtkfb_pins_lcm_errflag_out1_gpio>;
	pinctrl-14 = <&mtkfb_pins_lcm_errflag_out0_gpio>;
	status = "okay";
};

&dispsys_config {
	pinctrl-names =
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te",
		"lcm_vci_out1_gpio", "lcm_vci_out0_gpio",

/dts-v1/;
/plugin/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6855-pinfunc.h>
#include "mediatek/mt6855-sia8159-PD2278.dtsi" /*vivo audio add for PA SIA8159*/

&mtk_leds {
	compatible = "mediatek,disp-leds";

	backlight {
		led_mode = <4>;
		gate_enable = <1>;
		pwm_config = <0 1 0 0 0>;
		label = "lcd-backlight";
		max-brightness = <2047>;
		led-bits = <11>;
		default-state="on";
	};
};

/* Trustonic Mobicore real driver */
&mobicore {
	trustonic,real-drv = <1>;
};

&pio {
	i2c0_active: i2c0_active {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO137__FUNC_SCL0>,<PINMUX_GPIO138__FUNC_SDA0>;
			bias-pull-up;
			mediatek,drive-strength-adv = <0>;
			drive-strength = <2>;
		};
	};
	i2c0_suspend: i2c0_suspend {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO137__FUNC_GPIO137>,<PINMUX_GPIO138__FUNC_GPIO138>;
			bias-pull-down;
		};
	};
};

&i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	mediatek,use-open-drain;

	lm3697_i2c@36 {
		compatible = "ktd3136", "aw99703";
		reg = <0x36>;
		status = "okay";
		leds_vivo,parallel_num = <3>;
		leds_vivo,hbm_current_values = /bits/ 8 <0xd 0x12 0x13 0x16>; //note: [0]=ctrl_a_fs_current,  [1]=hbm1, [2]=hbm2, [3]=hbm3
	};

	SM5109@3E {
		compatible = "SM5109";
		reg = <0x3E>;
		status = "okay";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&i2c0_active>;
		pinctrl-1 = <&i2c0_suspend>;
	};

};
&pio {
	mtkfb_pins_lcm_led_en1: lcm_led_en1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO161__FUNC_GPIO161>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_led_en0: lcm_led_en0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO161__FUNC_GPIO161>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO95__FUNC_GPIO95>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO95__FUNC_GPIO95>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO94__FUNC_DSI_TE>;
		};
	};
};

&mtkfb {
	pinctrl-names = "lcm_led_en1_gpio", "lcm_led_en0_gpio",
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_led_en1>;
	pinctrl-1 = <&mtkfb_pins_lcm_led_en0>;
	pinctrl-2 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-3 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
	status = "okay";
};

&dispsys_config {
	pinctrl-names =
		"lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	// switch_fps = <120>;
	panel1@0 {
		compatible = "PD2278,hx,nt36672c,vdo,120hz";
		reg = <0>;
		lcm_backlight_en-gpios = <&pio 134 0>;
		reset-gpios = <&pio 95 0>;
		gate-ic = <0>;
		lcm_enp-gpios = <&pio 183 0>;
		lcm_enn-gpios = <&pio 182 0>;
		rc-enable = <1>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
		vivo_panel_power_on {
			type =
				"gpio,high", "lcm_enp-gpios",
				"delay,usleep", "4180 4380",
				"gpio,high", "lcm_enn-gpios";
		};

		vivo_panel_power_off {
			type =
				"gpio,low", "lcm_enn-gpios",
				"delay,usleep", "5180 5380",
				"gpio,low", "lcm_enp-gpios",
				"delay,usleep", "4180 4380";
		};

		vivo_panel_reset {
			type =
				"delay,usleep", "5000 5100",
				"gpio,low", "reset-gpios",
				"delay,usleep", "5000 5100",
				"gpio,high", "reset-gpios",
				"delay,usleep", "1000 1100",
				"gpio,low", "reset-gpios",
				"delay,usleep", "5000 5100",
				"gpio,high", "reset-gpios",
				"delay,usleep", "12000 12100";
		};

		vivo_panel_shutdown {
			type =
				"delay,usleep", "3300 3800",
				"gpio,low", "reset-gpios",
				"delay,usleep", "2300 2800",
				"gpio,low", "lcm_enn-gpios",
				"delay,usleep", "5180 5380",
				"gpio,low", "lcm_enp-gpios",
				"delay,usleep", "4180 4380";
		};

		vivo_bkg_en_high {
			type =
				"delay,usleep", "1000 1100",
				"gpio,high", "lcm_backlight_en-gpios",
				"delay,usleep", "5000 5100";
		};

		vivo_bkg_en_low {
			type =
				"delay,usleep", "5000 5100",
				"gpio,low", "lcm_backlight_en-gpios",
				"delay,usleep", "5000 5100";
		};

	};
	panel2@0 {
		compatible = "PD2278,tm,ili7807s,vdo,120hz";
		reg = <1>;
		lcm_backlight_en-gpios = <&pio 134 0>;
		reset-gpios = <&pio 95 0>;
		gate-ic = <0>;
		lcm_enp-gpios = <&pio 183 0>;
		lcm_enn-gpios = <&pio 182 0>;
		rc-enable = <1>;
		pinctrl-names = "default";
		port {
			panel_in2: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
		vivo_panel_power_on {
			type =
				"gpio,high", "lcm_enp-gpios",
				"delay,usleep", "3000 3200",
				"gpio,high", "lcm_enn-gpios",
				"delay,usleep", "12000 12200";
		};

		vivo_panel_power_off {
			type =
				"gpio,low", "lcm_enn-gpios",
				"delay,usleep", "5180 5380",
				"gpio,low", "lcm_enp-gpios",
				"delay,usleep", "4180 4380";
		};

		vivo_panel_reset {
			type =
				"delay,usleep", "5000 5100",
				"gpio,low", "reset-gpios",
				"delay,usleep", "5000 5100",
				// "gpio,high", "reset-gpios",
				// "delay,usleep", "1000 1100",
				// "gpio,low", "reset-gpios",
				// "delay,usleep", "5000 5100",
				"gpio,high", "reset-gpios",
				"delay,usleep", "12000 12100";
		};

		vivo_panel_shutdown {
			type =
				"delay,usleep", "3300 3800",
				"gpio,low", "reset-gpios",
				"delay,usleep", "2300 2800",
				"gpio,low", "lcm_enn-gpios",
				"delay,usleep", "5180 5380",
				"gpio,low", "lcm_enp-gpios",
				"delay,usleep", "4180 4380";
		};

		vivo_bkg_en_high {
			type =
				"delay,usleep", "1000 1100",
				"gpio,high", "lcm_backlight_en-gpios",
				"delay,usleep", "5000 5100";
		};

		vivo_bkg_en_low {
			type =
				"delay,usleep", "5000 5100",
				"gpio,low", "lcm_backlight_en-gpios",
				"delay,usleep", "5000 5100";
		};

	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};

/* GPS GPIO standardization start */
&pio {
	gps_pins_default: gps_default {
	};
	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO133__FUNC_GPIO133>;
			output-low;
		};
	};
	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO133__FUNC_GPS_L1_ELNA_EN>;
		};
	};
	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO133__FUNC_GPIO133>;
			output-high;
		};
	};
	gps_l5_lna_pins_ol: gps_l5_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO134__FUNC_GPIO134>;
			output-low;
		};
	};
	gps_l5_lna_pins_dsp_ctrl: gps_l5_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO134__FUNC_GPS_L5_ELNA_EN>;
		};
	};
	gps_l5_lna_pins_oh: gps_l5_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO134__FUNC_GPIO134>;
			output-high;
		};
	};
};
&gps {
	pinctrl-names = "default",
		"gps_l1_lna_disable",
		"gps_l1_lna_dsp_ctrl",
		"gps_l1_lna_enable",
		"gps_l5_lna_disable",
		"gps_l5_lna_dsp_ctrl",
		"gps_l5_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	pinctrl-4 = <&gps_l5_lna_pins_ol>;
	pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
	pinctrl-6 = <&gps_l5_lna_pins_oh>;
	status = "okay";
};
/* GPS GPIO standardization end */

#include "mediatek/cust_mt6855_camera_PD2278.dtsi"

/* AUDIO GPIO standardization start */
&afe{
	pinctrl-names = "aud_clk_mosi_off",
					"aud_clk_mosi_on",
					"aud_sync_mosi_off",
					"aud_sync_mosi_on",
					"aud_dat_mosi_off",
					"aud_dat_mosi_on",
					"aud_dat_miso0_off",
					"aud_dat_miso0_on",
					"aud_dat_miso1_off",
					"aud_dat_miso1_on",
					"aud_dat_miso2_off",
					"aud_dat_miso2_on",
					"vow_dat_miso_off",
					"vow_dat_miso_on",
					"vow_clk_miso_off",
					"vow_clk_miso_on",
					"aud_nle_mosi_off",
					"aud_nle_mosi_on";
			pinctrl-0 = <&aud_clk_mosi_off>;
			pinctrl-1 = <&aud_clk_mosi_on>;
			pinctrl-2 = <&aud_sync_mosi_off>;
			pinctrl-3 = <&aud_sync_mosi_on>;
			pinctrl-4 = <&aud_dat_mosi_off>;
			pinctrl-5 = <&aud_dat_mosi_on>;
			pinctrl-6 = <&aud_dat_miso0_off>;
			pinctrl-7 = <&aud_dat_miso0_on>;
			pinctrl-8 = <&aud_dat_miso1_off>;
			pinctrl-9 = <&aud_dat_miso1_on>;
			pinctrl-10 = <&aud_dat_miso2_off>;
			pinctrl-11 = <&aud_dat_miso2_on>;
			pinctrl-12 = <&vow_dat_miso_off>;
			pinctrl-13 = <&vow_dat_miso_on>;
			pinctrl-14 = <&vow_clk_miso_off>;
			pinctrl-15 = <&vow_clk_miso_on>;
			pinctrl-16 = <&aud_nle_mosi_off>;
			pinctrl-17 = <&aud_nle_mosi_on>;
};

&pio {
	aud_clk_mosi_off: aud_clk_mosi_off {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO172__FUNC_GPIO172>;
			input-enable;
			drive-strength = <2>;
			bias-pull-down;
		};
	};
	aud_clk_mosi_on: aud_clk_mosi_on {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO172__FUNC_AUD_CLK_MOSI>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
	};
	aud_sync_mosi_off: aud_sync_mosi_off {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO173__FUNC_GPIO173>;
			input-enable;
			drive-strength = <2>;
			bias-pull-down;
		};
	};
	aud_sync_mosi_on: aud_sync_mosi_on {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO173__FUNC_AUD_SYNC_MOSI>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
	};
	aud_dat_mosi_off: aud_dat_mosi_off {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO174__FUNC_GPIO174>;
			input-enable;
			drive-strength = <2>;
			bias-disable;
		};
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO175__FUNC_GPIO175>;
			input-enable;
			drive-strength = <2>;
			bias-disable;
		};
		pins_cmd2_dat {
			pinmux = <PINMUX_GPIO176__FUNC_GPIO176>;
			input-enable;
			bias-disable;
		};
	};
	aud_dat_mosi_on: aud_dat_mosi_on {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO174__FUNC_AUD_DAT_MOSI0>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO175__FUNC_AUD_DAT_MOSI1>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
		pins_cmd2_dat {
			pinmux = <PINMUX_GPIO176__FUNC_AUD_DAT_MOSI2>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	aud_dat_miso0_off: aud_dat_miso0_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO179__FUNC_GPIO179>;
			input-enable;
			bias-pull-down;
		};
	};
	aud_dat_miso0_on: aud_dat_miso0_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO179__FUNC_AUD_DAT_MISO0>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	aud_dat_miso1_off: aud_dat_miso1_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO180__FUNC_GPIO180>;
			input-enable;
			bias-disable;
		};
	};
	aud_dat_miso1_on: aud_dat_miso1_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO180__FUNC_AUD_DAT_MISO1>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	aud_dat_miso2_off: aud_dat_miso2_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO181__FUNC_GPIO181>;
			input-enable;
			bias-disable;
		};
	};
	aud_dat_miso2_on: aud_dat_miso2_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO181__FUNC_AUD_DAT_MISO2>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	vow_dat_miso_off: vow_dat_miso_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO179__FUNC_GPIO179>;
			input-enable;
			bias-pull-down;
		};
	};
	vow_dat_miso_on: vow_dat_miso_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO179__FUNC_VOW_DAT_MISO>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	vow_clk_miso_off: vow_clk_miso_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO180__FUNC_GPIO180>;
			input-enable;
			bias-pull-down;
		};
	};
	vow_clk_miso_on: vow_clk_miso_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO180__FUNC_VOW_CLK_MISO>;
			input-schmitt-enable;
			bias-disable;
		};
	};
	aud_nle_mosi_off: aud_nle_mosi_off {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO177__FUNC_GPIO177>;
			input-enable;
			drive-strength = <2>;
			bias-pull-down;
		};
		pins_cmd2_dat {
			pinmux = <PINMUX_GPIO178__FUNC_GPIO178>;
			input-enable;
			drive-strength = <2>;
			bias-pull-down;
		};
	};
	aud_nle_mosi_on: aud_nle_mosi_on {
		pins_cmd1_dat {
			pinmux = <PINMUX_GPIO177__FUNC_AUD_NLE_MOSI0>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
		pins_cmd2_dat {
			pinmux = <PINMUX_GPIO178__FUNC_AUD_NLE_MOSI1>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-disable;
		};
	};
};
/* AUDIO GPIO standardization end */

&pdc {
	pd_vbus_upper_bound = <12000000>;
};

/* add for proximity led by sensor team begin */
&mt6369_vio28 {
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-always-on;
};
/* add for proximity led by sensor team end*/

/* add by sensor team for SAR Power begin*/
&pio {
	sar_power_state: sar_power_rf_detect {
		pins_cmd0_dat {
			pinmux = <PINMUX_GPIO17__FUNC_GPIO17>,<PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <0>;
			bias-disable;
		};
	};
};

&sar_power {
	status="okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sar_power_state>;
	sar-power-rf-detect,gpios= <&pio 17 0x0>;
	sar-power-rf-detect_1,gpios= <&pio 19 0x0>;
};
/* add by sensor team for SAR Power end*/

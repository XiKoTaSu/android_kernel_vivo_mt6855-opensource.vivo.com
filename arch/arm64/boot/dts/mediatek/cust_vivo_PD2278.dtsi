/*************************
 * EINT DTSI File
*************************/

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

&subpmic_pmu_eint {
	interrupt-parent = <&pio>;
	interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
	status = "okay";
};

&mrdump_ext_rst {
	interrupt-parent = <&pio>;
	interrupts = <13 IRQ_TYPE_LEVEL_LOW>;
	deb-gpios = <&pio 13 0>;
	debounce = <512000>;
	status = "okay";
};

&touch {
	interrupt-parent = <&pio>;
	interrupts = <22 IRQ_TYPE_EDGE_FALLING>;
	status = "okay";
};

&rt5133_eint {
	interrupt-parent = <&pio>;
	interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
	status = "okay";
};

/* vivo audio add begin */
&sound {
		vivo,product-model = "PD2278";
};

&i2c6{
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;  /* must 400k */
	mediatek,use-open-drain;

	aw87xxx_pa: aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		reset-gpio = <&pio 162 0>;
		vivo,aw87xxx-acf = "aw87xxx_acf_PD2278.bin";
		dev_index = <0>;
		status = "okay";
	};
};

&odm {
	vivo-soc-codec@0 {
 		compatible = "vivo,vivo-soc-codec";
 		status = "okay";
 	};
	vivo-audio-ktv@0 {
		compatible = "vivo,vivo-audio-ktv";
		status = "okay";
	};
};

&accdet {
	accdet-mic-vol = <7>; //2.7v
	accdet-mic-mode = <1>; //ACC
	headset-key-mode = <1>; //0:ACCDET_THREE_KEY 1:ACCDET_FOUR_KEY
	headset-four-key-threshold = <0 62 106 220 447>; 
	headset-use-ap-eint = <1>; //0:ACCDET_PMIC_EINT_IRQ 1:ACCDET_AP_GPIO_EINT
	headset-mode-setting = <0x500 0x500 1 0x1f0
				0x800 0x800 0x4000 0x44
				0x4 0x1
				0x5 0x3 0x3 0x5 0xe>;
	accdet-plugout-debounce = <16>;
	headset-eint-num = <3>;//disable ACCDET_PMIC_EINT0
	interrupt-parent = <&pio>;
	interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
	interrupt-names = "ap_eint";
	deb-gpios = <&pio 21 0>;
	debounce = <256000>;
	pinctrl-names = "default", "state_eint_as_int";
	pinctrl-0 = <&accdet_pins_default>;
	pinctrl-1 = <&accdet_pins_eint_as_int>;
	status = "okay";
};


&pio {
	accdet_pins_default: accdetdefault {
	};
	accdet_pins_eint_as_int: accdeteint@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <0>;
			bias-disable;
		};
	};
};

/* vivo audio add end */

&dsi_te {
	interrupt-parent = <&pio>;
	interrupts = <94 IRQ_TYPE_EDGE_RISING>;
	status = "okay";
};



/*************************
 * MD1_EINT DTSI File
*************************/

&md1_sim1_hot_plug_eint {
	compatible = "mediatek,md1_sim1_hot_plug_eint-eint";
	interrupts = <0 8>;
	debounce = <0 100000>;
	dedicated = <0 0>;
	src_pin = <0 1>;
	sockettype = <0 0>;
	status = "okay";
};





&u2port0 {
	mediatek,eye-vrt = <0x7>;
	mediatek,eye-term = <0x3>;
	mediatek,rev6 = <0x1>;
	mediatek,eye-vrt-host = <0x7>;
	mediatek,eye-term-host = <0x3>;
	mediatek,rev6-host = <0x1>;
